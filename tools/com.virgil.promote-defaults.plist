<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent for the personal-prefs promotion pipeline.

  Runs tools/sync-defaults.sh on a fixed Tue/Fri 11:00 schedule. The
  wrapper reads the latest tools/personal-snapshot.json (kept fresh by
  the dev preview), folds the changes into the *.defaults.json sidecars
  + globals.css managed block, and commits + pushes if the diff is real.

  StartCalendarInterval (rather than StartInterval) so firing is
  deterministic: launchd waits until the next configured wall-clock
  moment the machine is awake. StartInterval would coalesce all the
  missed-while-asleep runs into a single delayed fire that's hard to
  reason about.

  Install / reload (idempotent):
    cp tools/com.virgil.promote-defaults.plist ~/Library/LaunchAgents/ && \
    launchctl unload ~/Library/LaunchAgents/com.virgil.promote-defaults.plist 2>/dev/null; \
    launchctl load ~/Library/LaunchAgents/com.virgil.promote-defaults.plist

  Inspect:
    launchctl list | grep virgil    # left column should be a PID

  Stop:
    launchctl unload ~/Library/LaunchAgents/com.virgil.promote-defaults.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.virgil.promote-defaults</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/gabriel/Programming/virgil/tools/sync-defaults.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/gabriel/Programming/virgil</string>

  <!-- Tuesday + Friday at 11:00 local. Array form: launchd treats each
       dict as an independent calendar trigger. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key>
      <integer>2</integer>
      <key>Hour</key>
      <integer>11</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key>
      <integer>5</integer>
      <key>Hour</key>
      <integer>11</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
  </array>

  <!-- Run immediately on (re)load so a fresh install promotes whatever
       the snapshot already has, instead of waiting up to 72h. -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/gabriel/Library/Logs/virgil-promote-defaults.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/gabriel/Library/Logs/virgil-promote-defaults.log</string>
</dict>
</plist>
