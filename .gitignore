# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-preview/
/out/

# production
/build

# misc
.DS_Store
*.pem

# claude code
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# virgil data (user documents)
/virgil-data

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# library — generated skill bundle + python bytecode
/public/skill-bundle/
/library/scripts/__pycache__/
*.pyc

# library/dev/iterations — scratch memos from /library/iterate-skill runs
/library/dev/iterations/*
!/library/dev/iterations/.gitkeep

# editor/dev — scratch memos and sandbox clones from /editor/iterate-virgil-editor runs
/editor/dev/iterations/*
!/editor/dev/iterations/.gitkeep
/editor/dev/sandboxes/*
!/editor/dev/sandboxes/.gitkeep

# virgil/dev — scratch diffs from the description-rewrite tooling + future
# closed-loop iteration output. The rewrite-descriptions.mjs script and any
# trigger-fitness corpora stay checked in; their generated output does not.
/virgil/dev/*.diff
/virgil/dev/iterations/*
!/virgil/dev/iterations/.gitkeep
/virgil/dev/sandboxes/*
!/virgil/dev/sandboxes/.gitkeep

# personal-prefs pipeline — Gabriel's localStorage mirror, regenerated
# constantly by the dev preview. The promote-defaults cron reads it locally
# to update the shipped defaults; the snapshot itself stays out of git.
/tools/personal-snapshot.json

# library-data — keep the static dev sample (catalog/master.bib/papers/),
# but ignore the runtime artifacts the live app writes back into the folder
# during a dev session (skill-bundle sync output, queue intent files, logs,
# concurrency lock sidecars).
/library-data/.skill-bundle-version.json
/library-data/.claude/
/library-data/scripts/
/library-data/CLAUDE.md
/library-data/queue/*.json
/library-data/queue/*.lock
/library-data/queue/*.done
/library-data/logs/
/library-data/master.bib.lock
/library-data/.virgil/catalog.json.lock
/library-data/.virgil/notifications/inbox.json.lock
