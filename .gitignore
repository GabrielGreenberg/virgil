# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-preview/
/out/

# production
/build

# misc
.DS_Store
*.pem

# claude code
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# virgil data (user documents)
/virgil-data

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# library — generated skill bundle + python bytecode
/public/skill-bundle/
/library/scripts/__pycache__/
*.pyc

# library/dev/iterations — scratch memos from /library/iterate-skill runs
/library/dev/iterations/*
!/library/dev/iterations/.gitkeep

# editor/dev — scratch memos and sandbox clones from /editor/iterate-virgil-editor runs
/editor/dev/iterations/*
!/editor/dev/iterations/.gitkeep
/editor/dev/sandboxes/*
!/editor/dev/sandboxes/.gitkeep

# virgil/dev — scratch diffs from the description-rewrite tooling + future
# closed-loop iteration output. The rewrite-descriptions.mjs script and any
# trigger-fitness corpora stay checked in; their generated output does not.
/virgil/dev/*.diff
/virgil/dev/iterations/*
!/virgil/dev/iterations/.gitkeep
/virgil/dev/sandboxes/*
!/virgil/dev/sandboxes/.gitkeep

# personal-prefs pipeline — Gabriel's localStorage mirror, regenerated
# constantly by the dev preview. The promote-defaults cron reads it locally
# to update the shipped defaults; the snapshot itself stays out of git.
/tools/personal-snapshot.json

# library-data — keep the static dev sample (catalog/master.bib +
# bringhurst1992 paper folder), but ignore the runtime artifacts the
# live app writes back into the folder during a dev session: ML model
# cache (multi-GB), queue intent files + completion markers, dev memos,
# merge reports, the machine-specific library-path, the runtime-synced
# script subdirs, and untracked paper extractions.
#
# The block below uses the current `.virgil/` layout; the legacy
# top-level paths (e.g. `/library-data/queue/`) are retained for
# migration safety but no longer match anything in the working tree.
/library-data/.virgil/models/
/library-data/.virgil/queue/*.json
/library-data/.virgil/queue/*.lock
/library-data/.virgil/queue/*.done
/library-data/.virgil/memos/
/library-data/.virgil/merge-reports/
/library-data/.virgil/library-path.json
/library-data/.virgil/scripts/editor/
/library-data/.virgil/scripts/library/
/library-data/.virgil/catalog.json.lock
/library-data/.virgil/notifications/inbox.json.lock
/library-data/master.bib.lock
# Untracked paper extractions accumulate during dev sessions. The
# bringhurst1992 sample is already in the index and stays tracked
# (gitignore doesn't un-track committed files); new paper folders
# under here are dropped from `git status`.
/library-data/papers/*
!/library-data/papers/bringhurst1992/
# Legacy / migration-safety patterns (the old top-level layout):
/library-data/.skill-bundle-version.json
/library-data/.claude/
/library-data/scripts/
/library-data/CLAUDE.md
/library-data/queue/*.json
/library-data/queue/*.lock
/library-data/queue/*.done
/library-data/logs/
