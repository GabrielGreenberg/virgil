# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# claude code
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# virgil data (user documents)
/virgil-data

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# library — generated skill bundle + python bytecode
/public/skill-bundle/
/library/scripts/__pycache__/
*.pyc

# library/dev/iterations — scratch memos from /library/iterate-skill runs
/library/dev/iterations/*
!/library/dev/iterations/.gitkeep

# editor/dev — scratch memos and sandbox clones from /editor/iterate-virgil-editor runs
/editor/dev/iterations/*
!/editor/dev/iterations/.gitkeep
/editor/dev/sandboxes/*
!/editor/dev/sandboxes/.gitkeep

# library-data — keep the static dev sample (catalog/master.bib/papers/),
# but ignore the runtime artifacts the live app writes back into the folder
# during a dev session (skill-bundle sync output, queue intent files, logs).
/library-data/.skill-bundle-version.json
/library-data/.claude/
/library-data/scripts/
/library-data/CLAUDE.md
/library-data/queue/*.json
/library-data/queue/*.lock
/library-data/queue/*.done
/library-data/logs/
