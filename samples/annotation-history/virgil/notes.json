        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "The contemporary case study here is Hypothes.is — a decade of running a marginalia layer over the open web. Worth a paragraph in §6 if there's room."
              }
            ]
          }
        ]
