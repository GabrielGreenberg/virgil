    {
      "kind": "note",
      "id": "ea4d5253-406d-499e-85b6-8055956c9f95",
      "title": "On Carolingian glossae",
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Worth distinguishing scholia (compiled, named) from glossae proper (anonymous, accreting). The Carolingian apparatus is closer to the latter — the gloss has no author."
              }
            ]
          }
        ]
      },
      "createdAt": "2026-04-24T19:00:00.000Z",
