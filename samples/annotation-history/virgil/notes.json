    {
      "id": "694cfc1f-d966-4c80-8090-1dc9ca1210a3",
      "title": "Marshall vs. Genette",
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Marshall's taxonomy is functional (what the annotation does); Genette's is positional (where the paratext sits). Worth contrasting them in a footnote."
              }
            ]
          }
        ]
      },
      "createdAt": "2026-04-24T19:02:00.000Z",
