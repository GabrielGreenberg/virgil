    {
      "id": "ed82253f-9002-44e7-8f80-6ed1ce22d7d2",
      "title": "Third tradition?",
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Add a third tradition: the footnote as procedural disclosure (cf. the methods section in empirical writing). The footnote-as-audit-trail and the footnote-as-voice both miss this."
              }
            ]
          }
        ]
      },
      "createdAt": "2026-04-24T19:01:00.000Z",
      "links": [
