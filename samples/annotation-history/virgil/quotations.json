    {
      "id": "44e0b65f-958d-402e-b4f7-06a55c755fc4",
      "title": "Bush, Memex, association",
      "references": [
        {
          "id": "a78d54c5-8f58-4984-92a6-536576ff4d5d",
          "citeKey": "vannevar1945",
          "quotes": [
            {
              "id": "31984b00-b19e-4a5a-ba14-05928ed6092c",
              "text": "The human mind operates by association. With one item in its grasp, it snaps instantly to the next that is suggested by the association of thoughts, in accordance with some intricate web of trails carried by the cells of the brain.",
              "page": "106"
            }
          ]
        }
      ],
      "notes": "The 'trails' word is what justifies the whole hypertext lineage.",
      "createdAt": "2026-04-24T19:13:00.000Z",
      "links": [
