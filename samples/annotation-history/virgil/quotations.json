        }
      ]
    },
    {
      "id": "ef0b7cdc-1c6d-43bc-b848-87c756899609",
      "title": "Jackson on what marginalia are",
      "references": [
        {
          "id": "3bdda969-54a2-4ee6-98eb-3ebc2c7a5c8e",
          "citeKey": "jackson2001",
          "quotes": [
            {
              "id": "31984b00-b19e-4a5a-ba14-05928ed6092b",
              "text": "Marginalia are not the residue of reading. They are reading made visible.",
              "page": "17"
            }
          ]
        }
      ],
      "notes": "",
      "createdAt": "2026-04-24T19:12:00.000Z",
