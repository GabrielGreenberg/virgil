      "id": "c690632d-7967-41f0-812e-94ee1093f0a5",
      "title": "Bringhurst on the margin",
      "references": [
        {
          "id": "2fc52e02-cfa6-4b90-a0f6-bdf04173fd86",
          "citeKey": "bringhurst2004",
          "quotes": [
            {
              "id": "7beae199-ec3f-41c4-9e86-1fbc4d9de6f6",
              "text": "The margin is what gives the text room to be a text. A page set without margins reads like a person speaking without breath.",
              "page": "64"
            }
          ]
        }
      ],
      "notes": "Use this in §2 to anchor the typographic claim.",
      "createdAt": "2026-04-24T19:10:00.000Z",
