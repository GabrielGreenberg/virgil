    {
      "id": "3200db1a-0d75-4765-bbd8-e3bdd62e0e2e",
      "title": "Genette on paratext",
      "references": [
        {
          "id": "04b1efa1-100e-46e7-a5d7-d257eeb7bf7a",
          "citeKey": "genette1997",
          "quotes": [
            {
              "id": "99c1de7d-16c5-46b0-a983-43f9578cee99",
              "text": "A paratext is what enables a text to become a book and to be offered as such to its readers and, more generally, to the public.",
              "page": "1"
            },
            {
              "id": "cf405357-c262-40e9-943c-26b08471b47a",
              "text": "More than a boundary or a sealed border, the paratext is a threshold.",
              "page": "2"
            }
          ]
        }
      ],
      "notes": "The two definitions Genette opens the book with — both useful.",
      "createdAt": "2026-04-24T19:11:00.000Z",
      "links": [
        {
