    {
      "id": "1960b087-0d6f-4db9-9a20-204d8d3a9419",
      "title": "Jackson on what marginalia are",
      "references": [
        {
          "id": "1262d591-ed71-40f6-957d-6c2c81fe6e7a",
          "citeKey": "jackson2001",
          "quotes": [
            {
              "id": "be70b70b-53c8-4635-a6d4-bd9b959155aa",
              "text": "Marginalia are not the residue of reading. They are reading made visible.",
