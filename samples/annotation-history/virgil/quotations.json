    {
      "id": "120628c7-1499-46fd-a627-0b4d334a694e",
      "title": "Bush, Memex, association",
      "references": [
        {
          "id": "c2147b03-87a8-4484-b171-19bc4ed7b5d0",
          "citeKey": "vannevar1945",
          "quotes": [
            {
              "id": "84c13daa-bd54-4659-8514-eee48d4a4c2a",
              "text": "The human mind operates by association. With one item in its grasp, it snaps instantly to the next that is suggested by the association of thoughts.",
              "page": "106"
            }
          ]
        }
      ],
      "notes": "The 'trails' word is what justifies the whole hypertext lineage.",
      "createdAt": "2026-04-24T19:13:00.000Z",
