    {
      "id": "c48fc95b-6a49-4e8b-a9e2-abf086e83f2f",
      "title": "On Bayle's apparatus",
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Bayle's Dictionnaire was, by some counts, the first scholarly work in which the apparatus exceeded the body in word count. The famous footnote on the Manichaeans runs to several pages of dense controversy, with footnotes-on-footnotes. It is the limit case of the whole footnoting impulse: where does the text end and the apparatus begin?"
              }
            ]
          }
        ]
      },
      "createdAt": "2026-04-23T15:30:00.000Z",
      "links": [
        {
