    {
      "id": "ebf861f9-f232-4b50-bf29-5cae5982a6d9",
      "title": "Hypothes.is and Genius",
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Two contemporary attempts to scaffold marginalia at scale: Hypothes.is, which aims for an open, standards-based annotation layer over the web; and Genius, which built a thriving annotation community around lyrics and speeches. Both show the appetite for shared marginalia is alive — but neither has solved moderation, attribution, and persistence."
              }
            ]
          }
        ]
      },
      "createdAt": "2026-04-24T09:00:00.000Z",
