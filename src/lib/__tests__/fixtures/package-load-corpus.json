    { "name": "space-before-brace", "preamble": "\\usepackage {biblatex}", "package": "biblatex", "expect": true },
    { "name": "space-before-options", "preamble": "\\usepackage [style=apa]{biblatex}", "package": "biblatex", "expect": true },
    { "name": "spaced-everywhere", "preamble": "\\usepackage [style=apa] {biblatex}", "package": "biblatex", "expect": true },
    { "name": "line-broken-options", "preamble": "\\usepackage[style=apa,\n backend=biber]\n{biblatex}", "package": "biblatex", "expect": true },
    { "name": "list-on-next-line", "preamble": "\\usepackage[style=apa]\n  {biblatex}", "package": "biblatex", "expect": true },
    { "name": "RequirePackage-spaced", "preamble": "\\RequirePackage {biblatex}", "package": "biblatex", "expect": true },
    { "name": "comma-list-padded", "preamble": "\\usepackage{amsmath, biblatex ,xcolor}", "package": "biblatex", "expect": true },
    { "name": "comma-list-line-broken", "preamble": "\\usepackage{amsmath,\n  natbib}", "package": "natbib", "expect": true },
    { "name": "wrapper-prefix", "preamble": "\\usepackage[authordate]{biblatex-chicago}", "package": "biblatex", "expect": true },
