    { "name": "other-package-only", "preamble": "\\usepackage{amsmath}\n\\usepackage[numbers]{natbib}", "package": "biblatex", "expect": false },
    { "name": "both-present/biblatex", "preamble": "\\usepackage{natbib}\n\\usepackage {biblatex}", "package": "biblatex", "expect": true },
    { "name": "both-present/natbib", "preamble": "\\usepackage{natbib}\n\\usepackage {biblatex}", "package": "natbib", "expect": true },
    { "name": "not-a-load-command", "preamble": "\\newcommand{\\biblatex}{x}", "package": "biblatex", "expect": false },
