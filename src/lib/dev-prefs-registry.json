{
  "_comment": "Single source of truth for the personal-prefs promotion pipeline. Both src/lib/dev-prefs-mirror.ts (browser) and tools/promote-defaults.mjs (Node) read this file. Edit here when adding a promotable pref — never duplicate the list elsewhere.",
  "promotable": [
    {
      "storageKey": "virgil-view-prefs/global",
      "defaultsFile": "src/hooks/useViewPrefs.defaults.json",
      "strategy": "whitelist",
      "whitelist": [
        "placements",
        "showHighlights",
        "hiddenHighlightTypes",
        "pageWidth",
        "editorLeftMargin",
        "editorRightMargin",
        "editorTopMargin",
        "editorBottomMargin",
        "codePaneRatio",
        "showCardTitles",
        "showLatexComments",
        "showMarginalia",
        "hiddenMarginaliaTypes",
        "showHeadingLabels",
        "omniDimResting",
        "cardOutlineChrome",
        "checkSpelling",
        "autocorrectTypos",
        "dividerLevels",
        "dividerWidth",
        "omniHiddenCategories"
      ]
    },
    {
      "storageKey": "virgil-editor-prefs",
      "defaultsFile": "src/hooks/usePreferences.defaults.json",
      "strategy": "replace-all"
    },
    {
      "_comment": "Must follow the virgil-editor-prefs entry: bakes the user's global colour transforms into the colour rows it just promoted, computed from the RAW colours in that blob (task 902).",
      "storageKey": "virgil-editor-transforms",
      "defaultsFile": "src/hooks/usePreferences.defaults.json",
      "strategy": "bake-transforms",
      "rawFrom": "virgil-editor-prefs"
    },
    {
      "storageKey": "virgil-panel-colors",
      "defaultsFile": "src/lib/panel-theme.defaults.json",
      "strategy": "replace-all"
    },
    {
      "storageKey": "virgil-view-prefs/global",
      "subPath": "printOptions",
      "defaultsFile": "src/lib/print.defaults.json",
      "strategy": "print-options"
    },
    {
      "storageKey": "virgil-library-view-session",
      "subPath": "layout",
      "defaultsFile": "library/lib/list-columns.defaults.json",
      "strategy": "whitelist",
      "whitelist": ["colOrder"]
    }
  ]
}
