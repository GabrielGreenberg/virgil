{
  "_comment": "Single source of truth for the personal-prefs promotion pipeline. Both src/lib/dev-prefs-mirror.ts (browser) and tools/promote-defaults.mjs (Node) read this file. Edit here when adding a promotable pref — never duplicate the list elsewhere.",
  "promotable": [
    {
      "storageKey": "virgil-view-prefs/global",
      "defaultsFile": "src/hooks/useViewPrefs.defaults.json",
      "strategy": "whitelist",
      "whitelist": [
        "placements",
        "showHighlights",
        "hiddenHighlightTypes",
        "pageWidth",
        "editorLeftMargin",
        "editorRightMargin",
        "editorTopMargin",
        "editorBottomMargin",
        "showParTitles",
        "showLatexComments",
        "showMarginalia",
        "hiddenMarginaliaTypes",
        "showHeadingLabels",
        "omniDimResting",
        "dividerLevels",
        "dividerWidth",
        "omniCategories",
        "omniHideAllCards"
      ]
    },
    {
      "storageKey": "virgil-editor-prefs",
      "defaultsFile": "src/hooks/usePreferences.defaults.json",
      "strategy": "replace-all"
    },
    {
      "storageKey": "virgil-panel-colors",
      "defaultsFile": "src/lib/panel-theme.defaults.json",
      "strategy": "replace-all"
    },
    {
      "storageKey": "virgil-view-prefs/global",
      "subPath": "printOptions",
      "defaultsFile": "src/lib/print.defaults.json",
      "strategy": "print-options"
    }
  ],
  "cssVarMap": {
    "--background":                { "source": "editor.backgroundColor" },
    "--foreground":                { "source": "editor.foreground" },
    "--surface":                   { "source": "editor.surfaceColor" },
    "--border":                    { "source": "editor.borderColor" },
    "--border-light":              { "source": "editor.borderLight" },
    "--muted":                     { "source": "editor.mutedColor" },
    "--muted-light":               { "source": "editor.mutedLight" },
    "--accent":                    { "source": "editor.accentColor" },
    "--topbar-bg":                 { "source": "editor.topbarBackground" },
    "--topbar-bg-bottom":          { "source": "editor.topbarBackgroundBottom" },
    "--topbar-border":             { "source": "editor.topbarBorder" },
    "--tab-bg":                    { "source": "editor.tabBg" },
    "--library-bg":                { "source": "editor.libraryBg" },
    "--virgil-bar-text":           { "source": "editor.virgilBarText" },
    "--pod-panel":                 { "source": "editor.podPanel" },
    "--pod-toolbar":               { "source": "editor.podToolbar" },
    "--pod-dark":                  { "source": "editor.podDark" },
    "--header-bg":                 { "source": "editor.headerBg" },
    "--panel-admin-text-color":    { "source": "editor.panelAdminTextColor" },
    "--panel-admin-text-font":     { "source": "editor.panelAdminTextFont", "quote": true },
    "--editor-font-size":          { "source": "editor.editorFontSize", "unit": "rem" },
    "--editor-line-height":        { "source": "editor.editorLineHeight" },
    "--editor-text-color":         { "source": "editor.editorTextColor" },
    "--par-title-size":            { "source": "editor.parTitleSize", "unit": "rem" },
    "--par-title-color":           { "source": "editor.parTitleColor" },
    "--heading-annotation-color":  { "source": "editor.headingAnnotationColor" },
    "--heading-annotation-border": { "source": "editor.headingAnnotationBorder" },
    "--blockquote-border":         { "source": "editor.blockquoteBorder" },
    "--blockquote-text":           { "source": "editor.blockquoteText" },
    "--code-bg":                   { "source": "editor.codeBackground" },
    "--code-block-bg":             { "source": "editor.codeBlockBackground" },
    "--math-color":                { "source": "editor.mathColor" },
    "--math-prefix-color":         { "source": "editor.mathPrefixColor" },
    "--comment-color":             { "source": "editor.commentColor" },
    "--latex-comment-color":       { "source": "editor.latexCommentColor" },
    "--citation-color":            { "source": "editor.citationColor" },
    "--citation-border-color":     { "source": "editor.citationBorderColor" },
    "--note-color":                { "source": "editor.noteColor" },
    "--note-marker-border":        { "source": "editor.noteMarkerBorder" },
    "--mark-bg":                   { "source": "editor.markBackground" },
    "--mark-border":               { "source": "editor.markBorder" },
    "--latex-cmd-color":           { "source": "editor.latexCmdColor" },
    "--drag-highlight":            { "source": "editor.dragHighlight" },
    "--scrollbar-thumb":           { "source": "editor.scrollbarThumb" },
    "--panel-font-size":           { "source": "editor.panelFontSize", "unit": "px" },
    "--panel-header-size":         { "source": "editor.panelHeaderSize", "unit": "px" },
    "--page-preferred":            { "source": "view.pageWidth", "unit": "px" }
  }
}
